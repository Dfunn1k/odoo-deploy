# =============================================================================
# Configuración del servidor. Copia a .env con: scripts/setup-env.sh
# (genera las contraseñas, calcula el tuning de Postgres y deja permisos 600).
# No pongas comentarios al final de una línea con valor.
# =============================================================================

# --- Dominio -----------------------------------------------------------------
# El registro DNS A de DOMAIN debe apuntar a la IP del servidor antes del deploy.
DOMAIN=erp.example.com
# Correo para avisos de Let's Encrypt (vencimiento de certificados).
ACME_EMAIL=admin@example.com

# --- Archivos de compose (opcional) -------------------------------------------
# Añade overrides separados por ":". P. ej. para servir también el QA de Odoo 19:
# COMPOSE_FILE=compose.yml:compose.qa19.yml

# --- Versión de Odoo ------------------------------------------------------------
# Imagen base: odoo:<ODOO_VERSION>-<ODOO_RELEASE>
# Tags disponibles: https://hub.docker.com/_/odoo/tags
ODOO_VERSION=20.0
ODOO_RELEASE=20260926

# --- Enterprise ----------------------------------------------------------------
# true: descarga github.com/odoo/enterprise en el commit compatible con ODOO_RELEASE.
# El token va en secrets/github_token (lo escribe setup-env.sh).
ODOO_ENTERPRISE=false
# Opcional: fija Enterprise a un commit exacto en vez de calcularlo por fecha.
ODOO_ENTERPRISE_REF=

# --- Base de datos ---------------------------------------------------------------
DB_NAME=prod
# Superusuario de Postgres: solo para backups y administración, Odoo no lo usa.
POSTGRES_PASSWORD=
# Rol de Odoo (sin superusuario).
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=

# --- Odoo ------------------------------------------------------------------------
# Master password (gestor de bases, deshabilitado en producción).
ADMIN_PASSWD=
# Usuario administrador de la base (no puede ser "admin"); usa un email.
ODOO_ADMIN_LOGIN=
ODOO_ADMIN_PASSWORD=
ODOO_INIT_LANG=es_PE
# Módulos a instalar al crear la base (separados por comas), p. ej. l10n_pe,sale,account
ODOO_INIT_MODULES=

# auto: calcula con (CPU*2)+1 y lo limita por la RAM (ODOO_RAM_SHARE de la RAM para Odoo).
WORKERS=auto
ODOO_RAM_SHARE=0.5
MAX_CRON_THREADS=1
LOG_LEVEL=info

# --- Correo saliente (opcional) ------------------------------------------------
# SMTP_SSL=True usa STARTTLS (puerto 587).
SMTP_SERVER=
SMTP_PORT=587
SMTP_SSL=True
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_FROM_FILTER=

# --- Tuning de Postgres (setup-env.sh lo calcula según la RAM) -----------------
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB

# --- Backups ---------------------------------------------------------------------
BACKUP_DIR=/var/backups/odoo
BACKUP_RETENTION_DAYS=14
# Opcional: destino rclone fuera del servidor, p. ej. b2:mi-bucket/odoo
BACKUP_RCLONE_REMOTE=
